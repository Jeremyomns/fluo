# Fluo · réglages (copie ce fichier en « .env » à la racine du projet, puis remplis-le).
# Le fichier .env n'est jamais envoyé sur GitHub : il contient des secrets.

# Supabase → Project Settings → API (ou Data API) : adresse du projet
VITE_SUPABASE_URL=https://abcdefgh.supabase.co

# Supabase → Project Settings → API Keys : clé « Publishable » (publique, sans danger)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Supabase → bouton « Connect » → Transaction pooler (port 6543), avec ton mot de passe à la place de [YOUR-PASSWORD]
# ⚠️ SECRET : donne un accès complet à tes données.
DATABASE_URL=postgresql://postgres.abcdefgh:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Adresse(s) e-mail autorisée(s) à utiliser Fluo (séparées par des virgules)
ALLOWED_EMAILS=ton@email.fr
