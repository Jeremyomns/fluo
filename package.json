{
  "name": "fluo",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run build && npm run start -w server",
    "db:generate": "npm run db:generate -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "tsx --test shared/src/*.test.ts",
    "db:migrate": "npm run db:migrate -w server",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
